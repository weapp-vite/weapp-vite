{
  "version": 1,
  "name": "agent proof counter increments",
  "steps": [
    { "action": "route", "path": "/pages/agent-proof/index" },
    { "action": "wait", "selector": "#count", "timeoutMs": 5000 },
    { "action": "assert", "selector": "#count", "text": "0", "timeoutMs": 5000 },
    { "action": "tap", "selector": "#increment" },
    { "action": "assert", "selector": "#count", "text": "1", "timeoutMs": 5000 },
    { "action": "screenshot" }
  ]
}
