{
  "name": "rolldown-require",
  "type": "module",
  "version": "2.1.0",
  "description": "bundle and require a file using rolldown!",
  "author": "ice breaker <1324318532@qq.com>",
  "license": "MIT",
  "homepage": "https://github.com/weapp-vite/weapp-vite#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weapp-vite/weapp-vite.git",
    "directory": "packages/rolldown-require"
  },
  "bugs": {
    "url": "https://github.com/weapp-vite/weapp-vite/issues"
  },
  "keywords": [
    "weapp-vite",
    "weapp",
    "wechat",
    "mini-program",
    "miniprogram",
    "require",
    "rolldown",
    "runtime",
    "node",
    "cjs",
    "commonjs",
    "esm",
    "typescript",
    "bundle"
  ],
  "imports": {
    "#module-sync-enabled": {
      "module-sync": "./misc/true.js",
      "default": "./misc/false.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "misc"
  ],
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "dev": "tsdown -w --sourcemap",
    "build:watch": "tsdown -w --sourcemap",
    "build": "tsdown",
    "test": "vitest run",
    "test:dev": "vitest",
    "typecheck": "tsc --noEmit",
    "release": "pnpm publish",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      }
    },
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "peerDependencies": {
    "rolldown": "catalog:"
  },
  "dependencies": {
    "@rollup/pluginutils": "^5.5.1",
    "get-tsconfig": "^4.14.3"
  },
  "devDependencies": {
    "@types/pnpapi": "^0.0.5"
  }
}
