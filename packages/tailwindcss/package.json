{
  "name": "@weapp-vite/tailwindcss",
  "type": "module",
  "version": "0.2.0",
  "description": "基于 weapp-tailwindcss/core 的宿主无关编译控制器",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weapp-vite/weapp-vite.git",
    "directory": "packages/tailwindcss"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "README.md",
    "dist"
  ],
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run -c vitest.config.ts",
    "test:types": "tsd --files \"test-d/**/*.test-d.ts\"",
    "lint": "eslint ."
  },
  "dependencies": {
    "@weapp-tailwindcss/engine": "0.1.3",
    "@weapp-vite/hmr": "workspace:*",
    "pathe": "catalog:",
    "weapp-tailwindcss": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
