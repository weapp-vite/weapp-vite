{
  "name": "create-weapp-vite",
  "type": "module",
  "version": "2.9.1",
  "description": "create-weapp-vite tools and runtime components for modern WeChat and multi-platform mini-program development.",
  "author": "ice breaker <1324318532@qq.com>",
  "license": "MIT",
  "homepage": "https://github.com/weapp-vite/weapp-vite#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weapp-vite/weapp-vite.git",
    "directory": "packages/create-weapp-vite"
  },
  "bugs": {
    "url": "https://github.com/weapp-vite/weapp-vite/issues"
  },
  "keywords": [
    "weapp-vite",
    "weapp",
    "wechat",
    "mini-program",
    "miniprogram",
    "vite",
    "runtime"
  ],
  "sideEffects": false,
  "weapp-vite-dev": {
    "exports": {
      ".": "./src/index.ts"
    },
    "main": "./src/index.ts",
    "module": "./src/index.ts",
    "types": "./src/index.ts",
    "bin": "./dev/bin.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": "./bin/create-weapp-vite.js",
  "files": [
    "bin",
    "dist",
    "templates"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "catalog:sync": "node --import tsx scripts/generate-template-catalog.ts",
    "dev": "tsdown -w --sourcemap",
    "build": "tsdown",
    "prepack": "node --import tsx scripts/prepublish.ts && pnpm build",
    "test": "vitest run",
    "test:dev": "vitest",
    "pretest:types": "pnpm build",
    "test:types": "tsd",
    "typecheck": "tsc --noEmit",
    "release": "pnpm publish",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": "./bin/create-weapp-vite.js",
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "@npmcli/config": "^11.1.0",
    "@weapp-core/init": "workspace:*",
    "@weapp-core/logger": "workspace:*",
    "@weapp-core/shared": "workspace:*",
    "execa": "^10.0.1",
    "make-fetch-happen": "^16.0.1",
    "npm-registry-fetch": "^20.0.1",
    "pathe": "catalog:",
    "pkg-types": "catalog:",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@types/make-fetch-happen": "^10.0.4",
    "@types/npm-registry-fetch": "^8.0.9",
    "@types/npmcli__config": "^6.0.4"
  }
}
