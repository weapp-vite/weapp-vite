{
  "name": "@weapp-vite/eslint",
  "type": "module",
  "version": "0.3.0",
  "description": "Wevu compatibility ESLint plugin and recommended configuration",
  "author": "ice breaker <1324318532@qq.com>",
  "license": "MIT",
  "homepage": "https://github.com/weapp-vite/weapp-vite#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weapp-vite/weapp-vite.git",
    "directory": "packages/eslint"
  },
  "bugs": {
    "url": "https://github.com/weapp-vite/weapp-vite/issues"
  },
  "keywords": [
    "weapp-vite",
    "weapp",
    "wechat",
    "mini-program",
    "miniprogram",
    "eslint",
    "wevu",
    "vue",
    "pinia",
    "vue-router",
    "vite"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "dev": "tsdown -w --sourcemap",
    "build": "tsdown",
    "test": "vitest run --config ./vitest.config.ts",
    "test:types": "pnpm run test:types:check",
    "test:types:check": "cd test-d/compatibility-eslint-public-types && tsd",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "release": "pnpm publish",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "peerDependencies": {
    "eslint": ">=9"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1"
  }
}
