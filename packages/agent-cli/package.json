{
  "name": "@weapp-agent/cli",
  "type": "module",
  "version": "0.2.4",
  "private": false,
  "description": "AI coding agent for WeChat mini-programs",
  "author": "ice breaker <hi@sonofmagic.top>",
  "license": "MIT",
  "homepage": "https://vite.weapp.dev/guide/agent/getting-started",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weapp-vite/weapp-vite.git",
    "directory": "packages/agent-cli"
  },
  "bugs": {
    "url": "https://github.com/weapp-vite/weapp-vite/issues"
  },
  "keywords": [
    "weapp-vite",
    "weapp",
    "agent"
  ],
  "bin": {
    "weapp-agent": "dist/index.mjs"
  },
  "files": [
    "README.md",
    "dist",
    "skills"
  ],
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "prebuild": "node ../../scripts/weapp-agent/sync-skill.mjs",
    "test:pack": "node ../../scripts/weapp-agent/smoke-pack.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "catalog:",
    "@ai-sdk/openai": "catalog:",
    "@ai-sdk/openai-compatible": "catalog:",
    "@modelcontextprotocol/client": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "@weapp-vite/acceptance": "workspace:*",
    "@weapp-vite/mcp": "workspace:*",
    "ai": "catalog:",
    "commander": "15.1.0",
    "diff": "catalog:",
    "execa": "catalog:fixed",
    "ink": "8.0.0",
    "ink-text-input": "6.0.0",
    "react": "catalog:",
    "weapp-ide-cli": "workspace:*",
    "zod": "catalog:fixed"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@weapp-agent/core": "workspace:*",
    "@weapp-agent/mini-program": "workspace:*",
    "@weapp-agent/providers": "workspace:*",
    "tsdown": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
