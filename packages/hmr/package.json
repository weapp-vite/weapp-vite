{
  "name": "@weapp-vite/hmr",
  "type": "module",
  "version": "0.2.2",
  "description": "小程序宿主共享的编译批次、资产提交与交付协调内核",
  "license": "MIT",
  "homepage": "https://github.com/weapp-vite/weapp-vite#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weapp-vite/weapp-vite.git",
    "directory": "packages/hmr"
  },
  "bugs": {
    "url": "https://github.com/weapp-vite/weapp-vite/issues"
  },
  "keywords": [
    "weapp-vite",
    "weapp",
    "mini-program",
    "hmr"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "README.md",
    "dist"
  ],
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run -c vitest.config.ts",
    "test:pure": "vitest run -c vitest.config.ts --coverage.enabled=false --maxWorkers=1",
    "test:types": "pnpm run test:types:check",
    "test:types:check": "tsd --files \"test-d/**/*.test-d.ts\"",
    "lint": "eslint ."
  },
  "dependencies": {
    "@jridgewell/remapping": "^2.3.5"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
