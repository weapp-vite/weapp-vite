{
  "name": "weapp-ide-cli",
  "type": "module",
  "version": "6.1.3",
  "description": "Command-line tools for automating WeChat DevTools and mini-program projects.",
  "author": "ice breaker <1324318532@qq.com>",
  "license": "MIT",
  "homepage": "https://github.com/weapp-vite/weapp-vite#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weapp-vite/weapp-vite.git",
    "directory": "packages/weapp-ide-cli"
  },
  "bugs": {
    "url": "https://github.com/weapp-vite/weapp-vite/issues"
  },
  "keywords": [
    "weapp-vite",
    "weapp",
    "wechat",
    "mini-program",
    "miniprogram",
    "weapp-cli",
    "cli",
    "uni-app",
    "taro",
    "ide",
    "weapp-ide",
    "mini"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "weapp": "bin/weapp.js",
    "weapp-ide-cli": "bin/weapp.js"
  },
  "weapp-vite-dev": {
    "exports": {
      ".": "./src/index.ts"
    },
    "main": "./src/index.ts",
    "module": "./src/index.ts",
    "types": "./src/index.ts",
    "bin": {
      "weapp": "dev/bin.js"
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsdown -w --sourcemap",
    "build": "tsdown",
    "release": "node scripts/release.js",
    "test:dev": "vitest",
    "test": "vitest run",
    "test:types": "pnpm build && tsd --files \"test-d/**/*.test-d.ts\"",
    "typecheck": "tsc --noEmit",
    "weapp": "tsx src/cli.ts",
    "debug": "tsx src/cli.ts config",
    "raw": "node bin/weapp.js",
    "sync": "cnpm sync weapp-ide-cli"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
      "weapp": "bin/weapp.js",
      "weapp-ide-cli": "bin/weapp.js"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@weapp-core/logger": "workspace:*",
    "@weapp-core/shared": "workspace:*",
    "@weapp-vite/devtools-runtime": "workspace:*",
    "@weapp-vite/miniprogram-automator": "workspace:*",
    "cac": "^7.0.0",
    "execa": "10.0.1",
    "pathe": "catalog:",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  },
  "tsd": {
    "compilerOptions": {
      "module": "NodeNext",
      "moduleResolution": "NodeNext"
    }
  }
}
