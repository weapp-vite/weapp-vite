{
  "name": "@weapp-vite/language-service",
  "type": "module",
  "version": "0.0.0",
  "description": "Shared mini-program language analysis and lossless formatting",
  "license": "MIT",
  "homepage": "https://vite.weapp.dev/packages/language-service",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weapp-vite/weapp-vite.git",
    "directory": "packages/language-service"
  },
  "bugs": { "url": "https://github.com/weapp-vite/weapp-vite/issues" },
  "keywords": ["weapp-vite", "miniprogram", "language-service", "formatter"],
  "sideEffects": false,
  "exports": {
    ".": { "types": "./dist/index.d.mts", "import": "./dist/index.mjs" },
    "./project": { "types": "./dist/project/index.d.mts", "import": "./dist/project/index.mjs" },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": ["dist"],
  "engines": { "node": "^22.23.4 || ^24.22.1 || >=26.12.1" },
  "scripts": {
    "build": "tsdown",
    "generate:schema": "node scripts/generateSchemas.ts",
    "sync:schema": "node scripts/syncSchemas.ts",
    "test": "vitest run --config ./vitest.config.ts",
    "test:types": "pnpm run test:types:check",
    "test:types:check": "tsd",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "peerDependencies": { "vite-plus": ">=1.2.0 <2" },
  "peerDependenciesMeta": { "vite-plus": { "optional": true } },
  "dependencies": {
    "@weapp-core/shared": "workspace:*",
    "@weapp-vite/ast": "workspace:*",
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.5",
    "picomatch": "^4.0.7"
  },
  "devDependencies": {
    "@types/picomatch": "^4.0.3",
    "typescript": "catalog:",
    "vite-plus": "1.2.0",
    "vitest": "^5.0.5"
  },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org" }
}
