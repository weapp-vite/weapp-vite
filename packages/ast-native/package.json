{
  "name": "@weapp-vite/ast-native",
  "type": "module",
  "version": "0.3.0",
  "description": "weapp-vite Rust/Oxc native AST analysis",
  "author": "ice breaker <1324318532@qq.com>",
  "license": "MIT",
  "homepage": "https://github.com/weapp-vite/weapp-vite#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weapp-vite/weapp-vite.git",
    "directory": "packages/ast-native"
  },
  "bugs": {
    "url": "https://github.com/weapp-vite/weapp-vite/issues"
  },
  "keywords": [
    "weapp-vite",
    "weapp",
    "wechat",
    "mini-program",
    "miniprogram",
    "ast",
    "native",
    "oxc",
    "rust",
    "vite"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./index.js",
  "module": "./index.js",
  "types": "./index.d.ts",
  "files": [
    "index.d.ts",
    "index.js"
  ],
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "prepack": "node ../../scripts/nativeAddonPublication/validate.mjs",
    "native:build": "napi build --esm --platform --release --no-js --dts target/index.d.ts -- --locked && pnpm native:stage",
    "native:build:debug": "napi build --esm --platform --no-js --dts target/index.d.ts && pnpm native:stage",
    "native:stage": "node ../../scripts/nativeAddonPublication/stage.mjs",
    "native:validate": "node ../../scripts/nativeAddonPublication/validate.mjs",
    "native:test": "pnpm native:build:debug && vitest run --config ./native.vitest.config.ts",
    "native:lint": "eslint package.json index.js index.d.ts native.vitest.config.ts test/**/*.test.ts"
  },
  "optionalDependencies": {
    "@weapp-vite/ast-native-darwin-arm64": "workspace:*",
    "@weapp-vite/ast-native-darwin-x64": "workspace:*",
    "@weapp-vite/ast-native-linux-arm64-gnu": "workspace:*",
    "@weapp-vite/ast-native-linux-x64-gnu": "workspace:*",
    "@weapp-vite/ast-native-win32-arm64-msvc": "workspace:*",
    "@weapp-vite/ast-native-win32-x64-msvc": "workspace:*"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.12",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "vitest": "5.1.1"
  },
  "napi": {
    "binaryName": "weapp_vite_ast_native",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ]
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
