      "import": "./dist/mcp.mjs"
    },
    "./types": {
      "types": "./dist/types.d.mts",
      "import": "./dist/types.mjs"
    },
    "./test": {
      "types": "./dist/test.d.mts",
      "import": "./dist/test.mjs"
    },
    "./compatibility": {
      "types": "./dist/compatibility.d.mts",
      "import": "./dist/compatibility.mjs"
    },
    "./eslint": {
      "types": "./dist/eslint.d.mts",
      "import": "./dist/eslint.mjs"
    },
    "./auto-import-components/resolvers": {
      "types": "./dist/auto-import-components/resolvers.d.mts",
      "import": "./dist/auto-import-components/resolvers.mjs"
    },
    "./resolvers": {
      "types": "./dist/resolvers.d.mts",
      "import": "./dist/resolvers.mjs"
    },
    "./auto-routes": {
      "types": "./dist/auto-routes.d.mts",
      "import": "./dist/auto-routes.mjs"
    },
    "./client": {
      "types": "./client.d.ts"
    },
    "./package.json": "./package.json",
    "./*": "./*",
    "./auto-import-presets": {
      "types": "./dist/auto-import-presets.d.mts",
      "import": "./dist/auto-import-presets.mjs"
    },
    "./auto-import-presets/wevu": {
      "types": "./dist/auto-import-presets/wevu.d.mts",
      "import": "./dist/auto-import-presets/wevu.mjs"
    },
    "./auto-import-presets/wevu-router": {
      "types": "./dist/auto-import-presets/wevu-router.d.mts",
      "import": "./dist/auto-import-presets/wevu-router.mjs"
    },
    "./doctor": {
      "types": "./dist/doctor.d.mts",
      "import": "./dist/doctor.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "weapp-vite": "bin/weapp-vite.js",
    "wv": "bin/weapp-vite.js"
  },
  "files": [
    "THIRD_PARTY_NOTICES.md",
    "bin",
    "client.d.ts",
    "dist",
    "modules/__weapp-vite-workers.js",
    "volar.cjs",
    "volar.d.cts"
