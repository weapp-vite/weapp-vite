    },
    "./dashboard/vite": {
      "types": "./dist/dashboard/vite.d.mts",
      "import": "./dist/dashboard/vite.mjs"
    },
    "./json": {
      "types": "./dist/json.d.mts",
      "import": "./dist/json.mjs"
    },
    "./volar": {
      "import": {
        "types": "./dist/volar.d.mts",
        "default": "./dist/volar.mjs"
      },
      "require": {
        "types": "./volar.d.cts",
        "default": "./volar.cjs"
      }
    },
    "./runtime": {
      "types": "./dist/runtime.d.mts",
      "import": "./dist/runtime.mjs"
    },
    "./i18n": {
      "types": "./dist/i18n.d.mts",
