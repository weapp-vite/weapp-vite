{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "description": "全局配置, 小程序根目录下的 app.json 文件用来对微信小程序进行全局配置。",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "appBar": {
      "additionalProperties": {},
      "description": "AppBar 配置。",
      "properties": {},
      "type": "object"
    },
    "chatTools": {
      "additionalProperties": {},
      "description": "聊天工具分包配置",
      "properties": {},
      "type": "object",
      "x-wechat-min-version": "3.7.8"
    },
    "componentFramework": {
      "description": "组件框架。仅在主动启用 WebView glass-easel 时需同时开启 glassEaselWebview。",
      "enum": [
        "exparser",
        "glass-easel"
      ],
      "type": "string"
    },
    "convertRpxToVw": {
      "description": "是否将 rpx 单位转换为 vw 单位。",
      "type": "boolean"
    },
    "darkmode": {
      "description": "小程序支持 DarkMode。",
      "type": "boolean"
    },
    "debug": {
      "description": "是否开启 debug 模式。",
      "type": "boolean"
    },
    "debugOptions": {
      "additionalProperties": {},
      "description": "调试相关配置。",
      "properties": {},
      "type": "object"
    },
    "embeddedAppIdList": {
      "description": "半屏小程序 appId 列表。",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "enablePassiveEvent": {
      "anyOf": [
        {
          "additionalProperties": {},
          "properties": {},
          "type": "object"
        },
        {
          "type": "boolean"
        }
      ],
      "description": "touch 事件监听是否为 passive",
      "x-wechat-min-version": "2.24.1"
    },
    "entranceDeclare": {
      "additionalProperties": {},
      "description": "微信消息用小程序打开。",
      "properties": {},
      "type": "object"
    },
    "entryPagePath": {
      "description": "小程序默认启动首页。",
      "type": "string"
    },
    "functionalPages": {
      "description": "是否启用插件功能页。",
      "type": "boolean",
      "x-wechat-min-version": "2.1.0"
    },
    "glassEaselWebview": {
      "description": "显式启用 WebView glass-easel，最低基础库为 3.8.12，默认不启用；需与 componentFramework: glass-easel 配套使用。",
      "type": "boolean",
      "x-wechat-min-version": "3.8.12"
    },
    "halfPage": {
      "additionalProperties": {},
      "description": "视频号直播半屏场景设置。",
      "properties": {},
      "type": "object"
    },
    "lazyCodeLoading": {
      "description": "配置自定义组件代码按需注入。",
      "type": "string"
    },
    "miniApp": {
      "additionalProperties": {},
      "description": "多端模式场景接入身份管理服务时开启小程序授权页相关配置，详见相关文档",
      "properties": {},
      "type": "object"
    },
    "networkTimeout": {
      "additionalProperties": {},
      "description": "网络超时时间。",
      "properties": {
        "connectSocket": {
          "default": 60000,
          "type": "number"
        },
        "downloadFile": {
          "default": 60000,
          "type": "number"
        },
        "request": {
          "default": 60000,
          "type": "number"
        },
        "uploadFile": {
          "default": 60000,
          "type": "number"
        }
      },
      "type": "object"
    },
    "pages": {
      "description": "页面路径列表。",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "permission": {
      "additionalProperties": {},
      "description": "小程序接口权限相关设置。",
      "properties": {},
      "type": "object"
    },
    "plugins": {
      "additionalProperties": {},
      "description": "使用到的插件。",
      "properties": {},
      "type": "object"
    },
    "preloadRule": {
      "additionalProperties": {},
      "description": "分包预下载规则。",
      "properties": {},
      "type": "object"
    },
    "renderer": {
      "default": "webview",
      "description": "全局默认的渲染后端。",
      "enum": [
        "webview",
        "skyline"
      ],
      "type": "string"
    },
    "rendererOptions": {
      "additionalProperties": {},
      "description": "渲染后端选项。",
      "properties": {
        "skyline": {
          "additionalProperties": {},
          "properties": {
            "defaultContentBox": {
              "default": false,
              "type": "boolean"
            },
            "defaultDisplayBlock": {
              "default": false,
              "type": "boolean"
            },
            "disableABTest": {
              "default": false,
              "type": "boolean"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "requiredBackgroundModes": {
      "description": "需要在后台使用的能力。",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "requiredPrivateInfos": {
      "description": "调用的地理位置相关隐私接口。",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "resizable": {
      "description": "PC 小程序是否支持用户任意改变窗口大小（包括最大化窗口）；iPad 小程序是否支持屏幕旋转。默认关闭",
      "type": "boolean",
      "x-wechat-min-version": "2.3.0"
    },
    "resolveAlias": {
      "additionalProperties": {},
      "description": "自定义模块映射规则。",
      "properties": {},
      "type": "object"
    },
    "serviceProviderTicket": {
      "description": "定制化型服务商票据",
      "type": "string"
    },
    "singlePage": {
      "additionalProperties": {},
      "description": "单页模式相关配置",
      "properties": {},
      "type": "object",
      "x-wechat-min-version": "2.12.0"
    },
    "sitemapLocation": {
      "description": "指明 sitemap.json 的位置。",
      "type": "string"
    },
    "static": {
      "additionalProperties": {},
      "description": "正常情况下默认所有资源文件都被打包发布到所有平台，可以通过 static 字段配置特定每个目录/文件只能发布到特定的平台(多端场景) 相关文档",
      "properties": {},
      "type": "object"
    },
    "style": {
      "description": "指定使用升级后的weui样式",
      "type": "string",
      "x-wechat-min-version": "2.8.0"
    },
    "subPackages": {
      "description": "分包结构配置（兼容别名）。",
      "items": {
        "additionalProperties": {},
        "properties": {
          "entry": {
            "type": "string"
          },
          "independent": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "pages": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "root": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "subpackages": {
      "description": "分包结构配置。",
      "items": {
        "additionalProperties": {},
        "properties": {
          "entry": {
            "type": "string"
          },
          "independent": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "pages": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "root": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array",
      "x-wechat-min-version": "1.7.3"
    },
    "supportedMaterials": {
      "additionalProperties": {},
      "description": "聊天素材小程序打开相关配置。",
      "properties": {},
      "type": "object"
    },
    "tabBar": {
      "additionalProperties": {},
      "description": "底部 tab 栏的表现。",
      "properties": {
        "backgroundColor": {
          "type": "string"
        },
        "borderStyle": {
          "default": "black",
          "enum": [
            "black",
            "white"
          ],
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "custom": {
          "type": "boolean"
        },
        "list": {
          "items": {
            "additionalProperties": {},
            "properties": {
              "iconPath": {
                "type": "string"
              },
              "pagePath": {
                "type": "string"
              },
              "selectedIconPath": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "pagePath",
              "text"
            ],
            "type": "object"
          },
          "maxItems": 5,
          "minItems": 2,
          "type": "array"
        },
        "position": {
          "default": "bottom",
          "enum": [
            "bottom",
            "top"
          ],
          "type": "string"
        },
        "selectedColor": {
          "type": "string"
        }
      },
      "required": [
        "color",
        "selectedColor",
        "backgroundColor",
        "list"
      ],
      "type": "object"
    },
    "themeLocation": {
      "description": "指明 theme.json 的位置。",
      "type": "string"
    },
    "useExtendedLib": {
      "additionalProperties": {},
      "description": "指定需要引用的扩展库。",
      "properties": {},
      "type": "object"
    },
    "usingComponents": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "全局自定义组件配置。",
      "propertyNames": {
        "type": "string"
      },
      "type": "object"
    },
    "window": {
      "additionalProperties": {},
      "description": "全局的默认窗口表现。",
      "properties": {
        "backgroundColor": {
          "default": "#ffffff",
          "type": "string"
        },
        "backgroundColorBottom": {
          "default": "#ffffff",
          "type": "string"
        },
        "backgroundColorTop": {
          "default": "#ffffff",
          "type": "string"
        },
        "backgroundTextStyle": {
          "default": "dark",
          "enum": [
            "dark",
            "light"
          ],
          "type": "string"
        },
        "enablePullDownRefresh": {
          "default": false,
          "type": "boolean"
        },
        "handleWebviewPreload": {
          "default": "static",
          "enum": [
            "static",
            "manual",
            "auto"
          ],
          "type": "string"
        },
        "homeButton": {
          "default": false,
          "type": "boolean"
        },
        "initialRenderingCache": {
          "enum": [
            "static",
            "dynamic",
            "capture"
          ],
          "type": "string"
        },
        "navigationBarBackgroundColor": {
          "default": "#000000",
          "type": "string"
        },
        "navigationBarTextStyle": {
          "default": "white",
          "type": "string"
        },
        "navigationBarTitleText": {
          "type": "string"
        },
        "navigationStyle": {
          "default": "default",
          "enum": [
            "default",
            "custom"
          ],
          "type": "string"
        },
        "onReachBottomDistance": {
          "default": 50,
          "type": "number"
        },
        "pageOrientation": {
          "default": "portrait",
          "enum": [
            "portrait",
            "auto",
            "landscape"
          ],
          "type": "string"
        },
        "restartStrategy": {
          "default": "homePage",
          "enum": [
            "homePage",
            "homePageAndLatestPage"
          ],
          "type": "string"
        },
        "visualEffectInBackground": {
          "default": "none",
          "enum": [
            "none",
            "hidden"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "workers": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "additionalProperties": {},
          "properties": {
            "isSubpackage": {
              "type": "boolean"
            },
            "path": {
              "type": "string"
            }
          },
          "type": "object"
        }
      ],
      "description": "Worker 代码放置的目录。"
    }
  },
  "required": [
    "pages"
  ],
  "type": "object",
  "x-wechat-doc": "https://developers.weixin.qq.com/miniprogram/dev/reference/configuration/app.html"
}
