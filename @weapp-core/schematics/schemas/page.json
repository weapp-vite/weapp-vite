{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "description": "页面配置, 支持对单个页面进行配置，可以在页面对应的 .json 文件来对本页面的表现进行配置",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "backgroundColor": {
      "default": "#ffffff",
      "description": "窗口的背景色",
      "type": "string"
    },
    "backgroundColorBottom": {
      "default": "#ffffff",
      "description": "底部窗口的背景色，仅 iOS 支持",
      "type": "string",
      "x-wechat-min-version": "6.5.16"
    },
    "backgroundColorContent": {
      "default": "#RRGGBBAA",
      "description": "页面容器背景色。",
      "type": "string"
    },
    "backgroundColorTop": {
      "default": "#ffffff",
      "description": "顶部窗口的背景色，仅 iOS 支持",
      "type": "string",
      "x-wechat-min-version": "6.5.16"
    },
    "backgroundTextStyle": {
      "default": "dark",
      "description": "下拉 loading 的样式，仅支持 dark / light",
      "enum": [
        "dark",
        "light"
      ],
      "type": "string"
    },
    "componentFramework": {
      "description": "组件框架。仅在主动启用 WebView glass-easel 时需同时开启 glassEaselWebview。",
      "enum": [
        "exparser",
        "glass-easel"
      ],
      "type": "string"
    },
    "componentPlaceholder": {
      "additionalProperties": {},
      "properties": {},
      "type": "object"
    },
    "disableScroll": {
      "default": false,
      "description": "设置为 true 时页面整体不能上下滚动。",
      "type": "boolean"
    },
    "enablePassiveEvent": {
      "anyOf": [
        {
          "additionalProperties": {},
          "properties": {},
          "type": "object"
        },
        {
          "type": "boolean"
        }
      ],
      "default": "否",
      "description": "事件监听是否为 passive，若对页面单独设置则会覆盖全局的配置，详见 全局配置",
      "x-wechat-min-version": "2.24.1"
    },
    "enablePullDownRefresh": {
      "default": false,
      "description": "是否开启当前页面下拉刷新。详见 Page.onPullDownRefresh",
      "type": "boolean"
    },
    "glassEaselWebview": {
      "description": "显式启用 WebView glass-easel，最低基础库为 3.8.12，默认不启用；需与 componentFramework: glass-easel 配套使用。",
      "type": "boolean",
      "x-wechat-min-version": "3.8.12"
    },
    "handleWebviewPreload": {
      "default": "static",
      "description": "控制预加载下个页面的时机。支持 static / manual / auto",
      "enum": [
        "static",
        "manual",
        "auto"
      ],
      "type": "string",
      "x-wechat-min-version": "2.15.0"
    },
    "homeButton": {
      "default": false,
      "description": "在非首页、非页面栈最底层页面或非tabbar内页面中的导航栏展示home键",
      "type": "boolean",
      "x-wechat-min-version": "8.0.24"
    },
    "initialRenderingCache": {
      "description": "页面初始渲染缓存配置。",
      "enum": [
        "static",
        "dynamic",
        "capture"
      ],
      "type": "string"
    },
    "navigationBarBackgroundColor": {
      "default": "#000000",
      "description": "导航栏背景颜色，如 #000000",
      "type": "string"
    },
    "navigationBarTextStyle": {
      "default": "white",
      "description": "导航栏标题、状态栏颜色，仅支持 black / white",
      "type": "string"
    },
    "navigationBarTitleText": {
      "description": "导航栏标题文字内容",
      "type": "string"
    },
    "navigationStyle": {
      "default": "default",
      "description": "导航栏样式，仅支持以下值：default 默认样式 custom 自定义导航栏，只保留右上角胶囊按钮。",
      "enum": [
        "default",
        "custom"
      ],
      "type": "string",
      "x-wechat-min-version": "7.0.0"
    },
    "onReachBottomDistance": {
      "default": 50,
      "description": "页面上拉触底事件触发时距页面底部距离，单位为px。详见 Page.onReachBottom",
      "type": "number"
    },
    "pageOrientation": {
      "default": "portrait",
      "description": "屏幕旋转设置，支持 auto / portrait / landscape 详见 响应显示区域变化",
      "enum": [
        "portrait",
        "auto",
        "landscape"
      ],
      "type": "string",
      "x-wechat-min-version": "2.4.0"
    },
    "renderer": {
      "default": "webview",
      "description": "页面渲染后端。",
      "enum": [
        "webview",
        "skyline"
      ],
      "type": "string"
    },
    "rendererOptions": {
      "additionalProperties": {},
      "default": "否",
      "description": "渲染后端选项，详情相关文档",
      "properties": {
        "skyline": {
          "additionalProperties": {},
          "properties": {
            "defaultContentBox": {
              "default": false,
              "type": "boolean"
            },
            "defaultDisplayBlock": {
              "default": false,
              "type": "boolean"
            },
            "disableABTest": {
              "default": false,
              "type": "boolean"
            }
          },
          "type": "object"
        }
      },
      "type": "object",
      "x-wechat-min-version": "3.1.0"
    },
    "restartStrategy": {
      "default": "homePage",
      "description": "重新启动策略配置",
      "enum": [
        "homePage",
        "homePageAndLatestPage"
      ],
      "type": "string",
      "x-wechat-min-version": "2.8.0"
    },
    "singlePage": {
      "additionalProperties": {},
      "default": "否",
      "description": "单页模式相关配置",
      "properties": {},
      "type": "object",
      "x-wechat-min-version": "2.12.0"
    },
    "style": {
      "default": "default",
      "description": "启用新版的组件样式",
      "type": "string",
      "x-wechat-min-version": "2.10.2"
    },
    "styleIsolation": {
      "description": "页面样式隔离策略。",
      "enum": [
        "page-isolated",
        "page-apply-shared",
        "page-shared"
      ],
      "type": "string"
    },
    "usingComponents": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "页面自定义组件配置。",
      "propertyNames": {
        "type": "string"
      },
      "type": "object"
    },
    "visualEffectInBackground": {
      "default": "none",
      "description": "切入系统后台时，隐藏页面内容，保护用户隐私。支持 hidden / none，若对页面单独设置则会覆盖全局的配置，详见 全局配置",
      "enum": [
        "none",
        "hidden"
      ],
      "type": "string",
      "x-wechat-min-version": "2.15.0"
    }
  },
  "type": "object",
  "x-wechat-doc": "https://developers.weixin.qq.com/miniprogram/dev/reference/configuration/page.html"
}
