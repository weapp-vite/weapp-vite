{
  "source": "https://developers.weixin.qq.com/miniprogram/dev/reference/configuration/page.html",
  "fields": {
    "navigationBarBackgroundColor": {
      "type": "HexColor",
      "default": "#000000",
      "description": "导航栏背景颜色，如 #000000"
    },
    "navigationBarTextStyle": {
      "type": "string",
      "default": "white",
      "description": "导航栏标题、状态栏颜色，仅支持 black / white"
    },
    "navigationBarTitleText": {
      "type": "string",
      "description": "导航栏标题文字内容"
    },
    "navigationStyle": {
      "type": "string",
      "default": "default",
      "description": "导航栏样式，仅支持以下值：default 默认样式 custom 自定义导航栏，只保留右上角胶囊按钮。",
      "x-wechat-min-version": "7.0.0"
    },
    "homeButton": {
      "type": "boolean",
      "default": "false",
      "description": "在非首页、非页面栈最底层页面或非tabbar内页面中的导航栏展示home键",
      "x-wechat-min-version": "8.0.24"
    },
    "backgroundColor": {
      "type": "HexColor",
      "default": "#ffffff",
      "description": "窗口的背景色"
    },
    "backgroundColorContent": {
      "type": "HexColor",
      "default": "#RRGGBBAA",
      "description": "页面容器背景色。"
    },
    "backgroundTextStyle": {
      "type": "string",
      "default": "dark",
      "description": "下拉 loading 的样式，仅支持 dark / light"
    },
    "backgroundColorTop": {
      "type": "string",
      "default": "#ffffff",
      "description": "顶部窗口的背景色，仅 iOS 支持",
      "x-wechat-min-version": "6.5.16"
    },
    "backgroundColorBottom": {
      "type": "string",
      "default": "#ffffff",
      "description": "底部窗口的背景色，仅 iOS 支持",
      "x-wechat-min-version": "6.5.16"
    },
    "enablePullDownRefresh": {
      "type": "boolean",
      "default": "false",
      "description": "是否开启当前页面下拉刷新。详见 Page.onPullDownRefresh"
    },
    "onReachBottomDistance": {
      "type": "number",
      "default": "50",
      "description": "页面上拉触底事件触发时距页面底部距离，单位为px。详见 Page.onReachBottom"
    },
    "pageOrientation": {
      "type": "string",
      "default": "portrait",
      "description": "屏幕旋转设置，支持 auto / portrait / landscape 详见 响应显示区域变化",
      "x-wechat-min-version": "2.4.0"
    },
    "disableScroll": {
      "type": "boolean",
      "default": false,
      "description": "设置为 true 时页面整体不能上下滚动。"
    },
    "usingComponents": {
      "type": "object",
      "description": "页面自定义组件配置。"
    },
    "initialRenderingCache": {
      "type": "string",
      "enum": [
        "static",
        "dynamic",
        "capture"
      ],
      "description": "页面初始渲染缓存配置。"
    },
    "style": {
      "type": "string",
      "default": "default",
      "description": "启用新版的组件样式",
      "x-wechat-min-version": "2.10.2"
    },
    "singlePage": {
      "type": "object",
      "default": "否",
      "description": "单页模式相关配置",
      "x-wechat-min-version": "2.12.0"
    },
    "restartStrategy": {
      "type": "string",
      "default": "homePage",
      "description": "重新启动策略配置",
      "x-wechat-min-version": "2.8.0"
    },
    "handleWebviewPreload": {
      "type": "string",
      "default": "static",
      "description": "控制预加载下个页面的时机。支持 static / manual / auto",
      "x-wechat-min-version": "2.15.0"
    },
    "visualEffectInBackground": {
      "type": "string",
      "default": "否",
      "description": "切入系统后台时，隐藏页面内容，保护用户隐私。支持 hidden / none，若对页面单独设置则会覆盖全局的配置，详见 全局配置",
      "x-wechat-min-version": "2.15.0"
    },
    "enablePassiveEvent": {
      "type": "object | boolean",
      "default": "否",
      "description": "事件监听是否为 passive，若对页面单独设置则会覆盖全局的配置，详见 全局配置",
      "x-wechat-min-version": "2.24.1"
    },
    "renderer": {
      "type": "string",
      "enum": [
        "webview",
        "skyline"
      ],
      "description": "页面渲染后端。"
    },
    "rendererOptions": {
      "type": "object",
      "default": "否",
      "description": "渲染后端选项，详情相关文档",
      "x-wechat-min-version": "3.1.0"
    },
    "componentFramework": {
      "type": "string",
      "description": "组件框架。仅在主动启用 WebView glass-easel 时需同时开启 glassEaselWebview。",
      "enum": [
        "exparser",
        "glass-easel"
      ]
    },
    "glassEaselWebview": {
      "type": "boolean",
      "description": "显式启用 WebView glass-easel，最低基础库为 3.8.12，默认不启用；需与 componentFramework: glass-easel 配套使用。",
      "x-wechat-min-version": "3.8.12"
    },
    "styleIsolation": {
      "type": "string",
      "enum": [
        "page-isolated",
        "page-apply-shared",
        "page-shared"
      ],
      "description": "页面样式隔离策略。"
    }
  }
}
