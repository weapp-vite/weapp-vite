{
  "name": "@weapp-core/types",
  "type": "module",
  "version": "1.2.0",
  "description": "Shared TypeScript intrinsic element types for WeChat and multi-platform mini-programs.",
  "license": "MIT",
  "homepage": "https://github.com/weapp-vite/weapp-vite#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weapp-vite/weapp-vite.git",
    "directory": "@weapp-core/types"
  },
  "bugs": {
    "url": "https://github.com/weapp-vite/weapp-vite/issues"
  },
  "keywords": [
    "weapp-vite",
    "weapp",
    "wechat",
    "mini-program",
    "miniprogram"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./weapp": {
      "types": "./dist/weappIntrinsicElements.d.mts",
      "import": "./dist/weappIntrinsicElements.mjs"
    },
    "./alipay": {
      "types": "./dist/alipayIntrinsicElements.d.mts",
      "import": "./dist/alipayIntrinsicElements.mjs"
    },
    "./tt": {
      "types": "./dist/ttIntrinsicElements.d.mts",
      "import": "./dist/ttIntrinsicElements.mjs"
    },
    "./miniprogram": {
      "types": "./dist/miniprogramIntrinsicElements.d.mts",
      "import": "./dist/miniprogramIntrinsicElements.mjs"
    },
    "./wechat-api": {
      "types": "./types/wechat-api.d.ts"
    },
    "./alipay-api": {
      "types": "./dist/alipay-api.d.mts",
      "import": "./dist/alipay-api.mjs"
    }
  },
  "typesVersions": {
    "*": {
      "weapp": [
        "dist/weappIntrinsicElements.d.mts"
      ],
      "alipay": [
        "dist/alipayIntrinsicElements.d.mts"
      ],
      "tt": [
        "dist/ttIntrinsicElements.d.mts"
      ],
      "miniprogram": [
        "dist/miniprogramIntrinsicElements.d.mts"
      ],
      "wechat-api": [
        "types/wechat-api.d.ts"
      ],
      "alipay-api": [
        "dist/alipay-api.d.mts"
      ]
    }
  },
  "files": [
    "THIRD_PARTY_NOTICES.md",
    "dist",
    "types"
  ],
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test:types": "pnpm build && pnpm run test:types:check",
    "test:types:check": "tsd --typings dist/index.d.mts --files \"test-d/**/*.test-d.ts\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prebuild": "node ./scripts/generate-platform-types.mjs",
    "predev": "node ./scripts/generate-platform-types.mjs",
    "pretypecheck": "node ./scripts/generate-platform-types.mjs"
  },
  "devDependencies": {
    "@mini-types/alipay": "catalog:",
    "miniprogram-api-typings": "catalog:",
    "tsd": "^0.33.0",
    "tsdown": "0.23.4",
    "typescript": "catalog:"
  },
  "tsd": {
    "compilerOptions": {
      "module": "NodeNext",
      "moduleResolution": "NodeNext",
      "paths": {}
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
