<view id="route" data-e2e-route="{{route}}">{{route}}</view>
<view id="prelude-log-count">{{preludeLog.length}}</view>
<view
  wx:for="{{preludeLog}}"
  wx:key="*this"
  class="prelude-log-item"
>
  {{item}}
</view>
<view wx:for="{{requestRuntime}}" wx:key="index" id="runtime-{{index}}">{{index}}={{item}}</view>
