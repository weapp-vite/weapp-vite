<view id="app-lifecycle-route" class="page" data-e2e-route="index">{{message}}</view>
<view id="watch-result">watch results: {{__watchLogs.length}}</view>
<view class="watch-result-value" wx:for="{{__watchLogs}}" wx:key="*this">{{item}}</view>
<view class="panel">
  <view class="panel-title">Hook status</view>
  <view id="app-hook-{{item.name}}" class="app-hook-status" wx:for="{{__e2eHooks}}" wx:key="name">{{item.name}}: {{item.status}}</view>
</view>
<view class="panel">
  <view class="panel-title">E2E Result</view>
  <view class="panel-row">Hooks: {{__e2eSummary.seen}}/{{__e2eSummary.total}}</view>
  <view class="panel-row">Skipped: {{__e2eSummary.skipped}}</view>
  <view class="panel-row">Logs: {{__e2eSummary.entries}}</view>
  <view class="panel-row">Last: {{__e2eSummary.lastHook}}</view>
</view>
<view class="panel">
  <view class="panel-title">E2E Logs (latest)</view>
  <view class="panel-row" wx:for="{{__e2ePreview}}" wx:key="order">
    {{item.order}}. {{item.hook}}{{item.skipped ? ' (skipped)' : ''}}
  </view>
</view>
<view class="panel">
  <view class="panel-title">Cold launch inputs</view>
  <view wx:for="{{__hostInputs}}" wx:key="hook">
    <view id="app-host-input-{{item.hook}}" class="app-host-input">{{item.host}}</view>
    <view id="app-hook-input-{{item.hook}}" class="app-hook-input">{{item.received}}</view>
  </view>
</view>
