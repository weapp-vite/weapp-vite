<view id="fixture-root" class="panel"><view id="inline"><text>A</text> <text>B</text></view><text id="spaces">prefix  {{label}}  suffix</text><text id="expression">{{ count + 1 }} / {{label}}</text><view wx:if="{{visible}}" id="conditional">visible {{count}}</view><view wx:else id="conditional-alternate">hidden</view><view wx:for="{{items}}" wx:key="id" class="item" id="item-{{item.id}}" data-id="{{item.id}}" bindtap="select">{{index}}:{{item.name}}</view><view id="event-parent" bindtap="onBubble"><button id="increment" bind:tap="increment">increment</button><button id="catch" catchtap="onCatch">catch</button></view><button id="toggle" bindtap="toggle">toggle</button><text id="state">{{count}}|{{bubbled}}|{{caught}}|{{selected}}</text><view id="style-probe" data-active="yes">rpx selector</view></view>
