#!/usr/bin/env sh
set -e

repo_root="$(git rev-parse --show-toplevel)"
node "$repo_root/scripts/dom-inventory-policy.mjs"
node "$repo_root/scripts/check-changeset-frontmatter.mjs" --staged --root "$repo_root"

workspace_root="$repo_root"

while [ "$workspace_root" != "/" ]; do
  if [ -x "$workspace_root/node_modules/.bin/lint-staged" ]; then
    break
  fi
  workspace_root="$(dirname "$workspace_root")"
done

if [ ! -x "$workspace_root/node_modules/.bin/lint-staged" ]; then
  echo "lint-staged binary not found from $repo_root upward" >&2
  exit 1
fi

"$workspace_root/node_modules/.bin/lint-staged" \
  --config "$repo_root/lint-staged.config.js" \
  --cwd "$repo_root"

# 自动修复会更新索引，提交前再核验最终暂存内容。
node "$repo_root/scripts/check-changeset-frontmatter.mjs" --staged --root "$repo_root"
