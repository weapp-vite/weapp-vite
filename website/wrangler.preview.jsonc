{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "weapp-vite-preview",
  "compatibility_date": "2026-10-26",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "preview.vite.weapp.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
