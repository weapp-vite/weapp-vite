{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "weapp-vite",
  "compatibility_date": "2026-08-16",
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "vite.weapp.dev",
      "custom_domain": true
    },
    {
      "pattern": "vite.icebreaker.top",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
