+use std::sync::Mutex;
+
+use crate::{
+  NormalizedDevOptions, OnAdditionalAssetsCallback, OnHmrUpdatesCallback, OnOutputCallback,
+};
+
+#[derive(Default)]
+struct Callbacks {
+  on_output: Option<OnOutputCallback>,
+  on_hmr_updates: Option<OnHmrUpdatesCallback>,
+  on_additional_assets: Option<OnAdditionalAssetsCallback>,
+}
+
+/// 终止关闭时释放通知所有权，已取得的调用快照仍可完成交付。
+#[derive(Default)]
+pub(crate) struct DevCallbacks {
+  callbacks: Mutex<Callbacks>,
+}
+
+impl DevCallbacks {
+  pub fn take_from(options: &mut NormalizedDevOptions) -> Self {
+    Self {
+      callbacks: Mutex::new(Callbacks {
+        on_output: options.on_output.take(),
+        on_hmr_updates: options.on_hmr_updates.take(),
+        on_additional_assets: options.on_additional_assets.take(),
+      }),
+    }
+  }
+
+  pub fn on_output(&self) -> Option<OnOutputCallback> {
+    self.callbacks.lock().expect("Dev callbacks lock poisoned").on_output.clone()
+  }
+
+  pub fn on_hmr_updates(&self) -> Option<OnHmrUpdatesCallback> {
+    self.callbacks.lock().expect("Dev callbacks lock poisoned").on_hmr_updates.clone()
+  }
+
+  pub fn on_additional_assets(&self) -> Option<OnAdditionalAssetsCallback> {
+    self.callbacks.lock().expect("Dev callbacks lock poisoned").on_additional_assets.clone()
+  }
+
+  pub fn has_on_hmr_updates(&self) -> bool {
+    self.callbacks.lock().expect("Dev callbacks lock poisoned").on_hmr_updates.is_some()
+  }
+
+  /// 必须先停止并等待全部通知生产者，再在锁外析构回调；NAPI使用正常release排空队列。
+  pub fn release(&self) {
+    let callbacks = {
+      let mut callbacks = self.callbacks.lock().expect("Dev callbacks lock poisoned");
+      std::mem::take(&mut *callbacks)
+    };
+    drop(callbacks);
+  }
+}
+
+#[cfg(test)]
+mod tests {
+  use std::sync::Arc;
+
+  use super::DevCallbacks;
+  use crate::{BundleOutput, DevOptions, normalize_dev_options};
+
+  #[test]
+  fn release_keeps_only_the_inflight_callback_snapshot_alive() {
+    let output_owner = Arc::new(());
+    let hmr_owner = Arc::new(());
+    let assets_owner = Arc::new(());
+    let output_weak = Arc::downgrade(&output_owner);
+    let hmr_weak = Arc::downgrade(&hmr_owner);
+    let assets_weak = Arc::downgrade(&assets_owner);
+    let mut options = normalize_dev_options(DevOptions {
+      on_output: Some(Arc::new(move |_| {
+        assert_eq!(Arc::strong_count(&output_owner), 1);
+      })),
+      on_hmr_updates: Some(Arc::new(move |_| {
+        assert_eq!(Arc::strong_count(&hmr_owner), 1);
+      })),
+      on_additional_assets: Some(Arc::new(move |_| {
+        assert_eq!(Arc::strong_count(&assets_owner), 1);
+      })),
+      ..DevOptions::default()
+    });
+    let callbacks = DevCallbacks::take_from(&mut options);
+    let in_flight = callbacks.on_output().expect("output callback");
+    assert!(callbacks.has_on_hmr_updates());
+    callbacks.release();
+    callbacks.release();
+    assert!(options.on_output.is_none());
+    assert!(options.on_hmr_updates.is_none());
+    assert!(options.on_additional_assets.is_none());
+    assert!(callbacks.on_output().is_none());
+    assert!(callbacks.on_hmr_updates().is_none());
+    assert!(callbacks.on_additional_assets().is_none());
+    assert!(!callbacks.has_on_hmr_updates());
+    assert!(output_weak.upgrade().is_some());
+    assert!(hmr_weak.upgrade().is_none());
+    assert!(assets_weak.upgrade().is_none());
+    in_flight(Ok(BundleOutput::default()));
+    drop(in_flight);
+    assert!(output_weak.upgrade().is_none());
+  }
+}
