+++ b/packages/weapp-vite/src/cli/commands/build/compileCache.ts
@@ -0,0 +1,18 @@
+import * as nodeModule from 'node:module'
+
+/** 首次实际构建前刷写已加载模块的缓存；可选优化不能改变构建与清理的错误语义。 */
+export function createBuildCompileCacheFlusher() {
+  let attempted = false
+  return () => {
+    if (attempted) {
+      return
+    }
+    attempted = true
+    try {
+      if (nodeModule.getCompileCacheDir?.()) {
+        nodeModule.flushCompileCache?.()
+      }
+    }
+    catch {}
+  }
+}
