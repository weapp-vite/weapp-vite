{
  "name": "@weapp-vite/web",
  "type": "module",
  "version": "1.5.1",
  "description": "Experimental web runtime for weapp-vite templates",
  "author": "ice breaker <1324318532@qq.com>",
  "license": "MIT",
  "homepage": "https://github.com/weapp-vite/weapp-vite#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weapp-vite/weapp-vite.git",
    "directory": "packages-runtime/web"
  },
  "bugs": {
    "url": "https://github.com/weapp-vite/weapp-vite/issues"
  },
  "keywords": [
    "weapp-vite",
    "weapp",
    "wechat",
    "mini-program",
    "miniprogram",
    "web",
    "vite",
    "runtime"
  ],
  "sideEffects": [
    "dist/runtime/index.mjs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./plugin": {
      "types": "./dist/plugin.d.mts",
      "import": "./dist/plugin.mjs"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.mts",
      "import": "./dist/runtime/index.mjs"
    },
    "./runtime/polyfill": {
      "types": "./dist/runtime/index.d.mts",
      "import": "./dist/runtime/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "tsdown -w --sourcemap",
    "build:watch": "tsdown -w --sourcemap",
    "build": "tsdown",
    "test": "vitest run",
    "test:coverage": "cross-env WEAPP_VITE_WEB_COVERAGE_STRICT=1 vitest run --coverage",
    "test:dev": "vitest",
    "test:types": "pnpm build && tsd",
    "typecheck": "tsc --noEmit"
  },
  "tsd": {
    "compilerOptions": {
      "module": "NodeNext",
      "moduleResolution": "NodeNext",
      "paths": {}
    }
  },
  "dependencies": {
    "@babel/parser": "catalog:",
    "@babel/traverse": "catalog:",
    "@babel/types": "catalog:",
    "@weapp-core/constants": "workspace:*",
    "@weapp-core/shared": "workspace:*",
    "domhandler": "^6.0.1",
    "esbuild": "catalog:",
    "htmlparser2": "catalog:",
    "lit": "^3.3.3",
    "magic-string": "catalog:",
    "pathe": "catalog:",
    "postcss": "catalog:",
    "postcss-selector-parser": "catalog:",
    "rolldown": "catalog:",
    "rolldown-require": "workspace:*",
    "wevu": "workspace:*"
  },
  "devDependencies": {
    "happy-dom": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
