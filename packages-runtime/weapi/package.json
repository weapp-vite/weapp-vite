{
  "name": "@wevu/api",
  "type": "module",
  "version": "0.3.0",
  "description": "Compatibility entry for @weapp-core/api",
  "author": "ice breaker <1324318532@qq.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weapp-vite/weapp-vite.git",
    "directory": "packages-runtime/weapi"
  },
  "bugs": {
    "url": "https://github.com/weapp-vite/weapp-vite/issues"
  },
  "keywords": [],
  "sideEffects": [
    "./dist/vitest/setup.mjs"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": {
        "types": "./types/index.d.ts",
        "default": "./dist/index.mjs"
      }
    },
    "./vitest": {
      "types": "./dist/vitest.d.mts",
      "import": "./dist/vitest.mjs"
    },
    "./vitest/setup": {
      "types": "./dist/vitest/setup.d.mts",
      "import": "./dist/vitest/setup.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./types/index.d.ts",
  "files": [
    "dist",
    "types"
  ],
  "scripts": {
    "dev": "tsdown -w",
    "build": "tsdown",
    "test": "vitest run",
    "test:dev": "vitest",
    "pretest:types": "pnpm build",
    "test:types": "tsd",
    "release": "pnpm publish",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json"
  },
  "peerDependencies": {
    "vitest": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "dependencies": {
    "@weapp-core/api": "workspace:*"
  },
  "tsd": {
    "compilerOptions": {
      "module": "NodeNext",
      "moduleResolution": "NodeNext",
      "paths": {}
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
