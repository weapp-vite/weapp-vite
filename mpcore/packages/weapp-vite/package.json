{
  "name": "@mpcore/weapp-vite",
  "type": "module",
  "version": "1.2.0",
  "description": "Compatibility adapter for weapp-vite test artifacts and mpcore E2E APIs",
  "author": "ice breaker <1324318532@qq.com>",
  "license": "MIT",
  "homepage": "https://github.com/weapp-vite/weapp-vite#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weapp-vite/weapp-vite.git",
    "directory": "mpcore/packages/weapp-vite"
  },
  "bugs": {
    "url": "https://github.com/weapp-vite/weapp-vite/issues"
  },
  "keywords": [
    "weapp-vite",
    "weapp",
    "wechat",
    "mini-program",
    "miniprogram",
    "vite"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./test": {
      "types": "./dist/test.d.mts",
      "import": "./dist/test.mjs"
    },
    "./e2e": {
      "types": "./dist/e2e.d.mts",
      "import": "./dist/e2e.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "README.md",
    "dist"
  ],
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown -w",
    "test": "vitest run",
    "test:types": "pnpm build && pnpm run test:types:check",
    "test:types:check": "tsd --files \"test-d/**/*.test-d.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "weapp-vite": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "tsd": {
    "compilerOptions": {
      "module": "NodeNext",
      "moduleResolution": "NodeNext"
    }
  }
}
