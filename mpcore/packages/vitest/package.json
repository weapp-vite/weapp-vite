{
  "name": "@mpcore/vitest",
  "type": "module",
  "version": "0.2.7",
  "description": "Vitest integration for @mpcore/test",
  "author": "ice breaker <1324318532@qq.com>",
  "license": "MIT",
  "homepage": "https://github.com/weapp-vite/weapp-vite#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weapp-vite/weapp-vite.git",
    "directory": "mpcore/packages/vitest"
  },
  "bugs": {
    "url": "https://github.com/weapp-vite/weapp-vite/issues"
  },
  "keywords": [
    "weapp-vite",
    "weapp",
    "wechat",
    "mini-program",
    "miniprogram",
    "vite"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./setup": {
      "types": "./dist/setup.d.mts",
      "import": "./dist/setup.mjs"
    },
    "./config": {
      "types": "./dist/config.d.mts",
      "import": "./dist/config.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "README.md",
    "dist"
  ],
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown -w",
    "test": "vitest run",
    "test:types": "pnpm build && pnpm run test:types:check",
    "test:types:check": "tsd --files \"test-d/**/*.test-d.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "vitest": ">=5.0.0"
  },
  "dependencies": {
    "@mpcore/test": "workspace:*"
  },
  "devDependencies": {
    "vitest": "~5.0.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "tsd": {
    "compilerOptions": {
      "module": "NodeNext",
      "moduleResolution": "NodeNext"
    }
  }
}
