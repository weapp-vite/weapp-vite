exports[`template e2e: wevu-features-app > renders all pages from app config > wevu-features-app::pages/use-provide-inject/index 1`] = `"<view class="use-provide-inject-page" data-v-umvgte=""><view class="use-provide-inject-page__title" data-v-umvgte=""> wevu provide / inject 特性展示 </view><view class="use-provide-inject-page__subtitle" data-v-umvgte=""> provider 与 inject 共同操作同一份状态，验证跨层响应式同步 </view><view class="use-provide-inject-page__toolbar" data-v-umvgte=""><view class="use-provide-inject-page__btn" id="provide-inc" data-v-umvgte="" data-wi-tap="i0"> provider -&gt; increment </view><view class="use-provide-inject-page__btn" id="provide-toggle-theme" data-v-umvgte="" data-wi-tap="i1"> provider -&gt; toggle theme </view></view><view class="{{__wv_cls_0}}" id="provide-state" data-v-umvgte=""> provider theme = {{sharedState.theme}}</view><view class="use-provide-inject-page__line" id="provide-count" data-v-umvgte=""> provider count = {{sharedState.count}}</view><view class="use-provide-inject-page__line" id="provide-last-action" data-v-umvgte=""> last action = {{sharedState.lastAction}}</view><use-provide-inject-feature id="inject-feature" data-v-umvgte="" title="组件内 inject()"/></view>"`;

exports[`template e2e: wevu-features-app > renders all pages from app config > wevu-features-app::pages/use-provide-inject-scope/index 1`] = `"<weapp-layout-provide-inject-scope __wvSlotOwnerId="{{__wvSlotOwnerId || __wvOwnerId || ''}}"><view class="provide-inject-scope-page" data-v-1hhhi1f=""><view class="provide-inject-scope-page__title" data-v-1hhhi1f=""> wevu provide / inject 深层作用域复现 </view><view class="provide-inject-scope-page__line" id="scope-page-provider" data-v-1hhhi1f=""> page provide = page-provide-value </view><provide-inject-scope-middle id="scope-middle" data-v-1hhhi1f=""/><provide-inject-slot-provider id="scope-slot-provider-component" data-v-1hhhi1f="" generic:scoped-slots-default="scoped-slot-stable-default-0" vue-slots="{{ {default:true} }}" __wvSlotOwnerId="{{__wvOwnerId || ''}}"/></view></weapp-layout-provide-inject-scope>"`;

exports[`template e2e: wevu-features-app > renders all pages from app config > wevu-features-app::pages/use-slots/index 1`] = `"<view class="use-slots-page" data-v-zjy13q=""><view class="use-slots-page__title" data-v-zjy13q=""> wevu useSlots 特性展示 </view><view class="use-slots-page__subtitle" data-v-zjy13q=""> 控制 slot 展示和内容，查看 slots 键与 class 变化 </view><view class="use-slots-page__toolbar" data-v-zjy13q=""><view class="{{__wv_cls_0}}" id="slots-ctrl-open" data-v-zjy13q="" data-wi-tap="i0"> panel: {{controlState.open ? 'open' : 'closed'}}</view><view class="{{__wv_cls_1}}" id="slots-ctrl-header" data-v-zjy13q="" data-wi-tap="i1"> header slot: {{controlState.withHeader ? 'on' : 'off'}}</view><view class="use-slots-page__btn" id="slots-ctrl-count" data-v-zjy13q="" data-wi-tap="i2"> count: {{controlState.count}}</view></view><view class="{{__wv_cls_2}}" id="slots-open-state" data-v-zjy13q=""> open state: {{controlState.open ? 'open' : 'closed'}}</view><use-slots-feature id="slots-feature" data-v-zjy13q="" title="组件内 useSlots()" open="{{controlState.open}}" vue-slots="{{ {header:true,default:true} }}"><weapp-slot-wrapper slot="header"><block wx:if="{{controlState.withHeader}}"><view class="use-slots-page__header" data-v-zjy13q=""> header slot content </view></block></weapp-slot-wrapper><view class="use-slots-page__body" data-v-zjy13q=""> default slot content {{controlState.count}}</view></use-slots-feature></view>"`;

exports[`template e2e: wevu-features-app > renders all pages from app config > wevu-features-app::pages/use-store/index 1`] = `"<view class="use-store-page" data-v-1fd91qi=""><view class="use-store-page__title" data-v-1fd91qi=""> wevu store 特性展示 </view><view class="use-store-page__subtitle" data-v-1fd91qi=""> 展示 setup/options store、storeToRefs、patch/reset、subscribe/onAction/plugin </view><view class="use-store-page__meta" id="store-plugin-records" data-v-1fd91qi=""> plugin records = {{pluginSummary}}</view><view class="use-store-page__meta" id="store-subscribe-count" data-v-1fd91qi=""> subscribe count = {{subscribeEventCount}}</view><view class="use-store-page__meta" id="store-subscribe-last" data-v-1fd91qi=""> subscribe last = {{subscribeLastEvent}}</view><view class="use-store-page__meta" id="store-action-counts" data-v-1fd91qi=""> action before/after/error = {{actionBeforeCount}}/{{actionAfterCount}}/{{actionErrorCount}}</view><view class="use-store-page__meta" id="store-action-last" data-v-1fd91qi=""> action last = {{actionLastName}}</view><view class="{{__wv_cls_0}}" data-v-1fd91qi=""><view class="use-store-page__section-title" data-v-1fd91qi=""> setup store </view><view class="use-store-page__line" id="store-setup-count" data-v-1fd91qi=""> setup count = {{setupCountValue}}</view><view class="use-store-page__line" id="store-setup-doubled" data-v-1fd91qi=""> setup doubled = {{setupDoubledValue}}</view><view class="use-store-page__line" id="store-setup-label" data-v-1fd91qi=""> setup label = {{setupLabelValue}}</view><view class="use-store-page__line" id="store-setup-visits" data-v-1fd91qi=""> setup visits = {{setupVisitsValue}}</view><view class="use-store-page__toolbar" data-v-1fd91qi=""><view class="use-store-page__btn" id="store-setup-inc" data-v-1fd91qi="" data-wi-tap="i0"> setup inc </view><view class="use-store-page__btn" id="store-setup-visit" data-v-1fd91qi="" data-wi-tap="i1"> setup visit </view><view class="use-store-page__btn" id="store-setup-rename" data-v-1fd91qi="" data-wi-tap="i2"> setup rename </view><view class="use-store-page__btn" id="store-setup-patch-object" data-v-1fd91qi="" data-wi-tap="i3"> setup patch object </view><view class="use-store-page__btn" id="store-setup-patch-fn" data-v-1fd91qi="" data-wi-tap="i4"> setup patch fn </view><view class="use-store-page__btn" id="store-setup-ref-write" data-v-1fd91qi="" data-wi-tap="i5"> setup refs write </view><view class="use-store-page__btn" id="store-setup-reset" data-v-1fd91qi="" data-wi-tap="i6"> setup reset </view></view></view><view class="{{__wv_cls_1}}" data-v-1fd91qi=""><view class="use-store-page__section-title" data-v-1fd91qi=""> options store </view><view class="use-store-page__line" id="store-options-count" data-v-1fd91qi=""> options count = {{optionsCountValue}}</view><view class="use-store-page__line" id="store-options-doubled" data-v-1fd91qi=""> options doubled = {{optionsDoubledValue}}</view><view class="use-store-page__line" id="store-options-label" data-v-1fd91qi=""> options label = {{optionsLabelValue}}</view><view class="use-store-page__line" id="store-options-items-size" data-v-1fd91qi=""> options items = {{optionsItemsSizeValue}}</view><view class="use-store-page__toolbar" data-v-1fd91qi=""><view class="use-store-page__btn" id="store-options-inc" data-v-1fd91qi="" data-wi-tap="i7"> options inc </view><view class="use-store-page__btn" id="store-options-rename" data-v-1fd91qi="" data-wi-tap="i8"> options rename </view><view class="use-store-page__btn" id="store-options-patch-object" data-v-1fd91qi="" data-wi-tap="i9"> options patch object </view><view class="use-store-page__btn" id="store-options-patch-fn" data-v-1fd91qi="" data-wi-tap="ia"> options patch fn </view><view class="use-store-page__btn" id="store-options-ref-write" data-v-1fd91qi="" data-wi-tap="ib"> options refs write </view><view class="use-store-page__btn" id="store-options-reset" data-v-1fd91qi="" data-wi-tap="ic"> options reset </view></view></view></view>"`;
