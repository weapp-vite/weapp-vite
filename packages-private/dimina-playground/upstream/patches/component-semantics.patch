+import { describe, expect, it } from 'vitest'
+import { ComponentModule } from '../../service/src/instance/component/component-module.js'
+import { Module } from '../src/core/module.js'
+
+describe('virtualHost service/render contract', () => {
+	it.each([true, false, undefined])('transfers actual virtualHost=%s without leaking metadata into props', (virtualHost) => {
+		const service = new ComponentModule({ options: { virtualHost }, properties: { value: Number } }, { component: true })
+		const render = new Module({})
+		render.setInitialData(service.getProps())
+		expect(render.virtualHost).toBe(virtualHost === true)
+		expect(Object.keys(render.props)).toEqual(['value'])
+		expect(Object.keys(render.propertySchemas)).toEqual(['value'])
+	})
+	it('supports hostless components with no declared properties', () => {
+		const service = new ComponentModule({ options: { virtualHost: true } }, { component: true })
+		const render = new Module({})
+		render.setInitialData(service.getProps())
+		expect(render.virtualHost).toBe(true)
+		expect(render.props).toEqual({})
+	})
+})
