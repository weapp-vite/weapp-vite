+++ b/fe/packages/render/__tests__/component-generics.spec.js
@@ -0,0 +1,206 @@
+import fs from 'node:fs'
+import os from 'node:os'
+import path from 'node:path'
+import vm from 'node:vm'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+describe('compiled generic and virtual components', () => {
+	const pagePath = 'pages/generics/index'
+	let projectDir
+	let outputDir
+	let originalTargetPath
+	let originalUint8Array
+	let renderLoader
+	let renderRuntime
+	let serviceLoader
+	let serviceRuntime
+
+	function writeProjectFile(filePath, content) {
+		const fullPath = path.join(projectDir, filePath)
+		fs.mkdirSync(path.dirname(fullPath), { recursive: true })
+		fs.writeFileSync(fullPath, content)
+	}
+
+	function evaluateLogicModule(module) {
+		vm.runInThisContext(module.code, {
+			filename: path.join(projectDir, `${module.path.replace(/^\//, '')}.js`),
+		})
+	}
+
+	beforeEach(() => {
+		vi.resetModules()
+		originalTargetPath = process.env.TARGET_PATH
+		originalUint8Array = globalThis.Uint8Array
+		// Vitest's jsdom realm can expose a different Uint8Array constructor than
+		// Node's TextEncoder. esbuild requires both to share the same realm.
+		globalThis.Uint8Array = new TextEncoder().encode('').constructor
+		projectDir = fs.mkdtempSync(path.join(os.tmpdir(), 'dimina-real-lifecycle-'))
+		outputDir = path.join(projectDir, 'dist')
+		process.env.TARGET_PATH = outputDir
+		globalThis.__realComponentLifecycleLogs = []
+		document.body.innerHTML = ''
+		vi.spyOn(console, 'log').mockImplementation(() => {})
+	})
+
+	afterEach(() => {
+		renderRuntime?.app?.unmount()
+		if (serviceRuntime) {
+			serviceRuntime.instances = {}
+			serviceRuntime.pageStates.clear()
+		}
+		if (serviceLoader) {
+			serviceLoader.staticModules = {}
+		}
+		if (renderLoader) {
+			renderLoader.staticModules = {}
+		}
+		delete globalThis.__realComponentLifecycleLogs
+		delete globalThis.__extraInfo
+		delete globalThis.modDefine
+		delete globalThis.modRequire
+		delete globalThis.Module
+		delete globalThis.DiminaServiceBridge
+		delete window.DiminaRenderBridge
+		globalThis.Uint8Array = originalUint8Array
+		if (originalTargetPath === undefined) delete process.env.TARGET_PATH
+		else process.env.TARGET_PATH = originalTargetPath
+		fs.rmSync(projectDir, { recursive: true, force: true })
+		vi.restoreAllMocks()
+	})
+
+
+	it.each([1, 2])('isolates generics and synchronizes virtual roots from initial value %s', async (initialValue) => {
+		const component = (name, config, template, options = '') => {
+			writeProjectFile(`components/${name}/index.json`, JSON.stringify({ component: true, ...config }))
+			writeProjectFile(`components/${name}/index.wxml`, template)
+			writeProjectFile(`components/${name}/index.js`, `Component({ properties: { value: Number }, ${options} })`)
+		}
+		writeProjectFile('app.json', JSON.stringify({ pages: [pagePath] }))
+		writeProjectFile('app.js', 'App({})')
+		writeProjectFile('project.config.json', JSON.stringify({ appid: 'generic-regression' }))
+		writeProjectFile(`${pagePath}.json`, JSON.stringify({ usingComponents: {
+			roots: '/components/roots/index', outlet: '/components/outlet/index', forward: '/components/forward/index',
+			alpha: '/components/alpha/index', beta: '/components/beta/index',
+		} }))
+		writeProjectFile(`${pagePath}.wxml`, `<view>
+			<roots value="{{value}}" />
+			<outlet wx:if="{{show}}" generic:item="alpha" value="{{value}}" bindpick="selected" />
+			<outlet generic:item="beta" value="{{value}}" />
+			<outlet value="{{value}}" />
+			<forward generic:item="beta" value="{{value}}" />
+		</view>`)
+		writeProjectFile(`${pagePath}.js`, `Page({data:{value:${initialValue},show:true},selected(event){globalThis.__realComponentLifecycleLogs.push(event.detail)}})`)
+		component('roots', {}, '<view wx:if="{{value >= 2 &amp;&amp; value != 4}}" class="root-a">A</view><view wx:if="{{value == 2 || value == 5}}" class="root-b">B</view>', 'options:{virtualHost:true}')
+		component('outlet', { componentGenerics: { item: { default: '/components/fallback/index' } } }, '<view class="outlet"><item value="{{value}}" bindpick="selected" /></view>', `methods:{selected(event){this.triggerEvent('pick', 'outlet:'+event.detail)}},options:{virtualHost:true},lifetimes:{attached(){globalThis.__realComponentLifecycleLogs.push('attached')},detached(){globalThis.__realComponentLifecycleLogs.push('detached')}}`)
+		component('forward', { usingComponents: { outlet: '/components/outlet/index' }, componentGenerics: { item: true } }, '<outlet generic:item="item" value="{{value}}" />')
+		for (const name of ['alpha', 'beta', 'fallback']) component(name, {}, `<view class="${name}">${name}:{{value}}</view>`)
+		const { getPages, storeInfo } = await import('../../compiler/src/env.js')
+		const { compileJS } = await import('../../compiler/src/core/logic-compiler.js')
+		const { compileML } = await import('../../compiler/src/core/view-compiler.js')
+		storeInfo(projectDir)
+		const pages = getPages()
+		await compileML(pages.mainPages, null, { completedTasks: 0 })
+		const logicModules = await compileJS(pages.mainPages, null, null, { completedTasks: 0 })
+		const compiledView = fs.readFileSync(
+			path.join(outputDir, 'main/pages_generics_index.js'),
+			'utf8',
+		)
+
+		globalThis.DiminaServiceBridge = {
+			invoke: vi.fn(),
+			publish: vi.fn((_bridgeId, message) => {
+				window.DiminaRenderBridge.onMessage(message)
+				return Promise.resolve()
+			}),
+		}
+		window.DiminaRenderBridge = {
+			invoke: vi.fn(),
+			publish: vi.fn((payload) => {
+				globalThis.DiminaServiceBridge.onMessage(JSON.parse(payload))
+			}),
+		}
+
+		await import('../../service/src/index.js')
+		serviceLoader = (await import('../../service/src/core/loader.js')).default
+		serviceRuntime = (await import('../../service/src/core/runtime.js')).default
+		await import('../src/index.js')
+		renderLoader = (await import('../src/core/loader.js')).default
+		renderRuntime = (await import('../src/core/runtime.js')).default
+
+		serviceLoader.staticModules = {}
+		serviceRuntime.instances = {}
+		serviceRuntime.pageStates.clear()
+		renderLoader.staticModules = {}
+		const { modDefine, modRequire } = await import('@dimina/common')
+		globalThis.modDefine = modDefine
+		globalThis.modRequire = modRequire
+		globalThis.Module = window.Module
+		renderRuntime.installVueRuntimeHelpers(globalThis)
+		vm.runInThisContext(compiledView, {
+			filename: path.join(outputDir, 'main/pages_generics_index.js'),
+		})
+
+		for (const module of logicModules) evaluateLogicModule(module)
+
+		modRequire(pagePath)
+
+		const bridgeId = 'bridge-real-lifecycle'
+		globalThis.DiminaServiceBridge.onMessage({ type: 'pageShow', body: { bridgeId } })
+		globalThis.DiminaServiceBridge.onMessage({
+			type: 'resourceLoaded',
+			body: { bridgeId, pagePath, query: {}, scene: 1001 },
+		})
+
+
+		expect(renderLoader.getModuleByPath('/components/outlet/index').moduleInfo.componentGenerics).toEqual({ item: { default: '/components/fallback/index' } })
+		expect(renderLoader.getModuleByPath('/components/fallback/index')).toBeDefined()
+		await vi.waitFor(() => expect(document.querySelectorAll('.outlet')).toHaveLength(4))
+		await vi.waitFor(() => expect(document.querySelectorAll('.beta')).toHaveLength(2))
+		expect(document.querySelector('.alpha').textContent).toBe(`alpha:${initialValue}`)
+		expect(document.querySelector('.fallback').textContent).toBe(`fallback:${initialValue}`)
+		const instances = Object.values(serviceRuntime.instances[bridgeId])
+		const page = instances.find(instance => instance.is === pagePath)
+		expect(instances.filter(instance => instance.is === '/components/outlet/index')).toHaveLength(4)
+		for (const element of document.querySelectorAll('.outlet')) {
+			expect(element.parentElement.getAttribute('name')).not.toBe('/components/outlet/index')
+		}
+		expect(document.querySelector('.alpha').parentElement.hasAttribute('data-dd-component-host')).toBe(true)
+		const alpha = instances.find(instance => instance.is === '/components/alpha/index')
+		alpha.triggerEvent('pick', 'alpha')
+		await vi.waitFor(() => expect(globalThis.__realComponentLifecycleLogs).toContain('outlet:alpha'))
+		page.setData({value:2})
+		await vi.waitFor(() => expect(document.querySelector('.alpha').textContent).toBe('alpha:2'))
+		expect([...document.querySelectorAll('.beta')].map(el => el.textContent)).toEqual(['beta:2', 'beta:2'])
+		expect(document.querySelector('.fallback').textContent).toBe('fallback:2')
+		const rootsId = Object.entries(serviceRuntime.instances[bridgeId]).find(([, instance]) => instance.is === '/components/roots/index')[0]
+		await vi.waitFor(() => expect(document.querySelectorAll('.root-a, .root-b')).toHaveLength(2))
+		const oldRoots = [...document.querySelectorAll('.root-a, .root-b')]
+		const scopeId = renderLoader.getModuleByPath('/components/roots/index').moduleInfo.id
+		for (const root of oldRoots) {
+			expect(renderRuntime.moduleRootIds.get(root)).toContain(rootsId)
+			expect(root.getAttribute('data-dd-style-host').split(' ')).toContain(scopeId)
+			expect(root.hasAttribute('data-dd-component-host')).toBe(false)
+		}
+		page.setData({value:3})
+		await vi.waitFor(() => expect(document.querySelectorAll('.root-a, .root-b')).toHaveLength(1))
+		expect(renderRuntime.moduleRootIds.get(oldRoots[1]) || []).not.toContain(rootsId)
+		page.setData({value:4})
+		await vi.waitFor(() => expect(document.querySelectorAll('.root-a, .root-b')).toHaveLength(0))
+		for (const root of oldRoots) expect(renderRuntime.moduleRootIds.get(root) || []).not.toContain(rootsId)
+		page.setData({value:5})
+		await vi.waitFor(() => expect(document.querySelectorAll('.root-a, .root-b')).toHaveLength(2))
+		const newRoots = [...document.querySelectorAll('.root-a, .root-b')]
+		for (const root of newRoots) expect(renderRuntime.moduleRootIds.get(root)).toContain(rootsId)
+		page.setData({show:false})
+		await vi.waitFor(() => expect(document.querySelector('.alpha')).toBeNull())
+		await vi.waitFor(() => expect(globalThis.__realComponentLifecycleLogs.filter(x => x === 'detached')).toHaveLength(1))
+		globalThis.DiminaServiceBridge.onMessage({ type:'pageUnload',body:{bridgeId} })
+		expect(globalThis.__realComponentLifecycleLogs.filter(x => x === 'attached')).toHaveLength(4)
+		expect(globalThis.__realComponentLifecycleLogs.filter(x => x === 'detached')).toHaveLength(4)
+		expect(serviceRuntime.instances[bridgeId]).toBeUndefined()
+		renderRuntime.app.unmount()
+		for (const root of [...oldRoots, ...newRoots]) expect(renderRuntime.moduleRootIds.get(root) || []).not.toContain(rootsId)
+		expect(renderRuntime.instance.has(rootsId)).toBe(false)
+		expect(renderRuntime.setupData.has(rootsId)).toBe(false)
+	}, 30_000)
+})
